# Core application mode
APP_ENV=development

# API
API_HOST=0.0.0.0
API_PORT=8000

# Web
WEB_PORT=3000

# Database (matches docker-compose scaffold defaults)
POSTGRES_DB=training_plan_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Optional explicit SQLAlchemy URL (overrides POSTGRES_* when set)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/training_plan_platform
# Optional dedicated integration-test DB URL
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/training_plan_platform_test

# Source upload pipeline
SOURCE_UPLOAD_DIR=var/uploads/sources
SOURCE_UPLOAD_MAX_BYTES=10485760

# Redis (for background jobs)
REDIS_HOST=localhost
REDIS_PORT=6379
